# This file belongs on the deployment host as deploy/.env.production.
# Never commit the real file.
DATABASE_URL=postgresql://application-user:replace-me@database.example.com:5432/the_programmer
DATABASE_SSL=true
CORS_ORIGIN=https://learn.example.com
AUTH_MODE=session
TRUST_PROXY=true
LOG_LEVEL=info
BODY_LIMIT_BYTES=65536
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
CLIENT_ERROR_RATE_LIMIT_MAX=20
CLIENT_ERROR_RATE_LIMIT_WINDOW_SECONDS=60

# Optional monitoring and push-delivery settings. Uncomment only when configured.
# METRICS_TOKEN=
# ERROR_REPORTING_URL=
# ERROR_REPORTING_TOKEN=
# EXPO_ACCESS_TOKEN=

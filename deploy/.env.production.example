# This file belongs on the deployment host as deploy/.env.production.
# Never commit the real file.
DATABASE_URL=postgresql://application-user:replace-me@database.example.com:5432/the_programmer
DATABASE_SSL=true
CORS_ORIGIN=https://learn.example.com
AUTH_MODE=session
TRUST_PROXY=true
LOG_LEVEL=info
DEPLOYMENT_ENVIRONMENT=production
BODY_LIMIT_BYTES=65536
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
CLIENT_ERROR_RATE_LIMIT_MAX=20
CLIENT_ERROR_RATE_LIMIT_WINDOW_SECONDS=60

# Monitoring secrets. Use unique randomly generated values; never commit the real file.
METRICS_TOKEN=replace-with-a-random-base64url-value-of-at-least-32-characters
ERROR_REPORTING_URL=https://replace-with-your-better-stack-ingesting-host
ERROR_REPORTING_TOKEN=replace-with-the-better-stack-source-token
ALERT_WEBHOOK_URL=https://uptime.betterstack.com/api/v1/prometheus/webhook/replace-me
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-00-prod-us-central-0.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USERNAME=replace-with-numeric-metrics-instance-id
GRAFANA_CLOUD_PROMETHEUS_TOKEN=replace-with-a-metrics-publisher-access-policy-token
GRAFANA_ROOT_URL=https://monitoring.example.com
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional push-delivery setting. Uncomment only when configured.
# EXPO_ACCESS_TOKEN=

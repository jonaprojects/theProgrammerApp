{
  "name": "the-programmer",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "backend:dev": "npm --prefix server run dev",
    "backend:build": "npm --prefix server run build",
    "backend:test": "npm --prefix server test",
    "backend:migrate": "npm --prefix server run db:migrate",
    "backend:backup": "npm --prefix server run db:backup --",
    "backend:verify-backup": "npm --prefix server run db:verify --",
    "backend:restore": "npm --prefix server run db:restore --",
    "test": "jest --watchAll",
    "test:ci": "jest --runInBand --watch=false",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web --output-dir dist"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/server/"
    ]
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@expo-google-fonts/heebo": "^0.2.3",
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo-google-fonts/jetbrains-mono": "^0.2.3",
    "@expo/metro-runtime": "~57.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native/assets-registry": "0.74.87",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.15",
    "expo-constants": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-code-highlighter": "^1.3.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "react-syntax-highlighter": "^15.6.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.18.0",
    "@types/react": "19.2.18",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/react-test-renderer": "19.1.0",
    "babel-preset-expo": "57.0.9",
    "jest": "^29.2.1",
    "jest-expo": "57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true
}

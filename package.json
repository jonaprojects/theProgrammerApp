{
  "name": "the-programmer",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "backend:dev": "npm --prefix server run dev",
    "backend:build": "npm --prefix server run build",
    "backend:test": "npm --prefix server test",
    "backend:migrate": "npm --prefix server run db:migrate",
    "backend:backup": "npm --prefix server run db:backup --",
    "backend:verify-backup": "npm --prefix server run db:verify --",
    "backend:restore": "npm --prefix server run db:restore --",
    "test": "jest --watchAll",
    "test:ci": "jest --runInBand --watch=false",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web --output-dir dist"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/server/"
    ]
  },
  "dependencies": {
    "@babel/runtime": "8.0.7",
    "@expo-google-fonts/heebo": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native/assets-registry": "0.88.0",
    "expo": "~58.0.11",
    "expo-asset": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-image": "~58.0.15",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-notifications": "~58.1.4",
    "expo-router": "~58.0.20",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.9",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-code-highlighter": "^1.3.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "react-syntax-highlighter": "^16.1.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@react-native/jest-preset": "0.88.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/react-test-renderer": "19.3.0",
    "babel-preset-expo": "58.0.15",
    "jest": "^30.5.2",
    "jest-expo": "58.0.11",
    "react-test-renderer": "19.3.1",
    "typescript": "~7.0.2"
  },
  "private": true
}

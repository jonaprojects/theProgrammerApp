NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/the_programmer
DATABASE_SSL=false
CORS_ORIGIN=http://localhost:8081,http://localhost:8082,http://localhost:19006
AUTH_MODE=session
TRUST_PROXY=false
BODY_LIMIT_BYTES=65536
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
CLIENT_ERROR_RATE_LIMIT_MAX=20
CLIENT_ERROR_RATE_LIMIT_WINDOW_SECONDS=60
APP_VERSION=development
# Set a random value of at least 32 characters to enable /internal/metrics.
# METRICS_TOKEN=
# Optional HTTPS endpoint receiving sanitized JSON error events.
# ERROR_REPORTING_URL=
# ERROR_REPORTING_TOKEN=
# Optional when Expo push access-token security is enabled for the EAS project.
# EXPO_ACCESS_TOKEN=
